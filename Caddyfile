{
    # Proxies in front whose X-Forwarded-For is believed. Default: none (Caddy faces clients).
    # Behind the FasorX host Caddy, docker-compose.fasorx.yml sets private_ranges.
    servers {
        trusted_proxies static {$TRUSTED_PROXIES:127.0.0.1/32}
    }
}

{$APP_DOMAIN:localhost}

root * /srv
encode gzip

header {
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    X-Frame-Options DENY
    Content-Security-Policy "default-src 'self'; connect-src 'self' {$VITE_FASORX_URL}; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' blob: data:; worker-src 'self' blob:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'"
    -Server
}

# HSTS only for real domains; on localhost it would also force https on other local dev servers
@prod not host localhost
header @prod Strict-Transport-Security "max-age=31536000"

# API and collaboration WebSocket go to the NestJS process. One X-Forwarded-For entry, the client
# as resolved through the trusted proxies, so the API (which trusts only this hop) sees the real IP
# for its rate limits.
handle /api/* {
    reverse_proxy api:3000 {
        header_up X-Forwarded-For {client_ip}
    }
}
handle /collab* {
    reverse_proxy api:3000 {
        header_up X-Forwarded-For {client_ip}
    }
}

# Static SPA with history fallback
handle {
    try_files {path} /index.html
    file_server
}
