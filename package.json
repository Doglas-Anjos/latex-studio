{
  "name": "latex-studio",
  "private": true,
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Doglas-Anjos/latex-studio.git"
  },
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "vitest run --passWithNoTests",
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "lan": "node scripts/lan.mjs",
    "test:latex": "vitest run --mode latex"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.5",
    "jsdom": "^30.1.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
