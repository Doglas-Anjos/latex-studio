# Copy to .env and fill in. Never commit .env. These defaults target `docker compose` (hosts
# `postgres`/`redis`); the README lists the lines to change for local development (`pnpm dev`).
NODE_ENV=development
# Caddy serves APP_DOMAIN with automatic TLS; APP_URL is the public origin (the collab WebSocket
# only accepts this Origin): https://<APP_DOMAIN> in production, http://localhost:5173 in dev.
APP_DOMAIN=localhost
APP_URL=https://localhost
API_PORT=3000

# Postgres: the password in DATABASE_URL must match POSTGRES_PASSWORD
POSTGRES_USER=latex
POSTGRES_PASSWORD=change-me
POSTGRES_DB=latex
DATABASE_URL=postgres://latex:change-me@postgres:5432/latex

# Redis (BullMQ, rate limit); the password must match REDIS_URL
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@redis:6379

# Identity: the application in front (FasorX) signs who is logged in; the API only verifies.
# RS256 with the issuer's JWKS or HS256 with a shared secret of at least 32 bytes; AUTH_ISSUER and
# AUTH_AUDIENCE are required with either. Leave all four empty for local mode (no login, every
# request from a localhost Host is the local user, and the API listens on loopback only): the API
# refuses to start that way unless APP_URL is http://localhost and NODE_ENV is not production, so
# a server or Docker Compose install always needs a verifier. Behind FasorX:
#   AUTH_JWKS_URL=https://fasorx.com.br/.well-known/jwks.json
#   AUTH_ISSUER=https://fasorx.com.br
#   AUTH_AUDIENCE=latex
# Any OIDC provider works the same way (see the README).
AUTH_JWKS_URL=
AUTH_SECRET=
AUTH_ISSUER=
AUTH_AUDIENCE=
# Longest token lifetime accepted, in seconds (a leaked token cannot be revoked before it expires)
AUTH_MAX_TOKEN_TTL_S=900
# Platform admins (see and govern every project and user), comma-separated e-mails
SUPERADMIN_EMAILS=
# LAN share: let friends on the local network edit a published project with a 4-digit PIN. Trusted
# network only (never real auth): allowed solely when APP_URL is http://localhost and NODE_ENV is
# not production. Set LAN_SHARE=1 to turn it on; LAN_SECRET (≥32 chars) then signs the session
# tokens. Leave empty to keep it off.
LAN_SHARE=
LAN_SECRET=
# The worker uses a least-privilege Postgres role (docker/postgres/worker-role.sql): it reads
# builds/projects, updates and deletes builds, and nothing else (no document text, comments,
# members, users or audit log). Create the role, then set this; leave empty to reuse DATABASE_URL
# (full access).
POSTGRES_WORKER_PASSWORD=
WORKER_DATABASE_URL=

# Web: where to fetch tokens and send people to log in; empty = local mode. Baked into the web
# image at build time. VITE_FASORX_APP names this app in FasorX (token endpoint and ?volta=).
# Behind FasorX: VITE_FASORX_URL=https://fasorx.com.br
VITE_FASORX_URL=
VITE_FASORX_APP=latex

# Storage (inside containers)
REPOS_DIR=/data/repos
BUILDS_DIR=/data/builds

# "Grafo de assuntos" size: how many areas surround the document, and how many terms surround each
# area (1-30). Empty = automatic, scaled to the document (a short article gets ~3 areas x 5 terms,
# a thesis ~7 x 8, a book up to 12 x 10). Set a number to fix it for every project.
SUBJECT_GRAPH_AREAS=
SUBJECT_GRAPH_TERMS=

# Compile worker. Capacity has two independent knobs (see "Capacidade e workers" in the README):
# the two *_CONCURRENCY values below set how many jobs ONE worker runs at once, and you add more
# workers by running more worker containers (docker compose up -d --scale worker=N).
# COMPILE_CONCURRENCY: compiles in parallel per worker. TOOLS_CONCURRENCY: export/format/wordcount
# jobs in parallel per worker. Size each to the CPU/RAM of the box (each compile can use
# COMPILE_MEMORY_MB).
COMPILE_CONCURRENCY=1
TOOLS_CONCURRENCY=1
COMPILE_TIMEOUT_MS=180000
# Per-compile memory cap, enforced on Linux with `prlimit --as` (virtual address space), inherited
# by every TeX child. A very large LuaLaTeX document may need this raised.
COMPILE_MEMORY_MB=1024
# LuaLaTeX can read and write files outside the project (Lua io.* is not fenced by kpathsea's
# paranoid mode). Leave false on a shared server; XeLaTeX covers fontspec documents.
COMPILE_ALLOW_LUALATEX=false
# OS sandbox (bubblewrap) around compiles and exports. auto = use it when available, require =
# refuse to start without it, off = disable (forced off on non-Linux dev). The docker-compose
# worker is set up for bubblewrap (see its security_opt) and defaults this to `require` when it is
# left unset here. Leave it commented for a server. Set `auto` only
# for local, non-Docker dev (Windows/macOS/MiKTeX), where `require` would refuse to start.
# COMPILE_SANDBOX=auto

# Quotas
MAX_UPLOAD_MB=50
PROJECT_QUOTA_MB=500
MAX_PROJECTS_PER_USER=50
# Total per user over every project they own (collaborators' writes count against the owner).
# Empty = no per-user cap.
USER_QUOTA_MB=
