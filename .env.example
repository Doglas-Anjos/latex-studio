# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
APP_DOMAIN=localhost
APP_URL=http://localhost:8080
API_PORT=3000

# Postgres
DATABASE_URL=postgres://latex:latex@postgres:5432/latex
POSTGRES_USER=latex
POSTGRES_PASSWORD=change-me
POSTGRES_DB=latex

# Redis (BullMQ, rate limit); the password must match REDIS_URL
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@redis:6379

# Identity: the application in front (FasorX) signs who is logged in; the API only verifies.
# RS256 with the issuer's JWKS or HS256 with a shared secret of at least 32 bytes; AUTH_ISSUER and
# AUTH_AUDIENCE are required with either. Leave all four empty for local mode (no login, every
# request from a localhost Host is the local user): the API refuses to start that way unless
# APP_URL is http://localhost.
AUTH_JWKS_URL=https://fasorx.com.br/.well-known/jwks.json
AUTH_SECRET=
AUTH_ISSUER=https://fasorx.com.br
AUTH_AUDIENCE=latex
# Longest token lifetime accepted, in seconds (a leaked token cannot be revoked before it expires)
AUTH_MAX_TOKEN_TTL_S=900
# The worker uses a least-privilege Postgres role (docker/postgres/worker-role.sql): it reads
# builds/projects/file_edits and a user's name+email, updates builds/projects, deletes
# builds/file_edits, and nothing else (no document text, comments, members or audit log). Create
# the role, then set this; leave empty to reuse DATABASE_URL (full access).
POSTGRES_WORKER_PASSWORD=
WORKER_DATABASE_URL=

# Web: where to fetch tokens and send people to log in; empty = local mode. Baked into the web
# image at build time. VITE_FASORX_APP names this app in FasorX (token endpoint and ?volta=).
VITE_FASORX_URL=https://fasorx.com.br
VITE_FASORX_APP=latex

# Storage (inside containers)
REPOS_DIR=/data/repos
BUILDS_DIR=/data/builds

# Compile worker
COMPILE_CONCURRENCY=1
COMPILE_TIMEOUT_MS=180000
COMPILE_MEMORY_MB=1024
# LuaLaTeX can read and write files outside the project (Lua io.* is not fenced by kpathsea's
# paranoid mode). Leave false on a shared server; XeLaTeX covers fontspec documents.
COMPILE_ALLOW_LUALATEX=false
# OS sandbox (bubblewrap) around compiles and exports. auto = use it when it works (recommended),
# require = refuse to start without it, off = disable. Always off on non-Linux dev machines.
COMPILE_SANDBOX=auto

# Quotas
MAX_UPLOAD_MB=50
PROJECT_QUOTA_MB=500
MAX_PROJECTS_PER_USER=50
