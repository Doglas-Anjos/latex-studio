# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
APP_DOMAIN=localhost
APP_URL=http://localhost:8080
API_PORT=3000

# Postgres
DATABASE_URL=postgres://latex:latex@postgres:5432/latex
POSTGRES_USER=latex
POSTGRES_PASSWORD=change-me
POSTGRES_DB=latex

# Redis (BullMQ, rate limit)
REDIS_URL=redis://redis:6379

# Sessions: 64 random bytes, e.g. `openssl rand -hex 64`
SESSION_SECRET=change-me

# Storage (inside containers)
REPOS_DIR=/data/repos
BUILDS_DIR=/data/builds

# Compile worker
COMPILE_CONCURRENCY=1
COMPILE_TIMEOUT_MS=180000
COMPILE_MEMORY_MB=1024

# Quotas
MAX_UPLOAD_MB=50
PROJECT_QUOTA_MB=500
MAX_PROJECTS_PER_USER=50

# First admin (created on boot if no admin exists)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
